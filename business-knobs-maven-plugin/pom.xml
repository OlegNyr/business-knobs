<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.olegnyr</groupId>
        <artifactId>business-knobs</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>business-knobs-maven-plugin</artifactId>
    <packaging>maven-plugin</packaging>

    <name>business-knobs-maven-plugin</name>
    <description>Maven plugin that generates business-knobs stand files from knobs.yaml
        (goal knobs:generate)</description>

    <prerequisites>
        <maven>3.9.0</maven>
    </prerequisites>

    <properties>
        <module.name>io.github.olegnyr.knobs.generator</module.name>
    </properties>

    <!-- Плагин Maven: исходный YAML разработчика → JSON на каждый стенд, каталог вывода — ресурс
         проекта. Инструмент сборки, а не библиотека сервиса: разбор YAML не попадает в рантайм
         сервисов. От модулей библиотеки не зависит: формат файла стенда — контракт, а не общий
         код. StandFileGenerator годится и без Maven (main). -->
    <dependencies>
        <!-- SnakeYAML и Jackson — версии из BOM Spring Boot. -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- API Maven даёт сам Maven при запуске плагина. -->
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
            <version>${maven.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-core</artifactId>
            <version>${maven.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
            <version>${maven-plugin-plugin.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- Только в тестах: вывод генератора обязан читаться библиотекой. В рантайм плагина
             библиотека не попадает — общий у них формат файла стенда, а не код. -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>business-knobs-impl</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-plugin-plugin</artifactId>
                <configuration>
                    <!-- mvn knobs:generate -->
                    <goalPrefix>knobs</goalPrefix>
                    <helpPackageName>io.github.olegnyr.knobs.generator</helpPackageName>
                </configuration>
                <executions>
                    <!-- mvn knobs:help -Ddetail — описание целей и параметров из Javadoc. -->
                    <execution>
                        <id>help-goal</id>
                        <goals>
                            <goal>helpmojo</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
