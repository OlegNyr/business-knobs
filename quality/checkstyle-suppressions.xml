<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
  "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
  "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<!--
  Тестовые источники из проверок исключены через
  <includeTestSourceDirectory>false</includeTestSourceDirectory> в pom.xml,
  поэтому отдельных src/test/-suppressions здесь нет.
-->
<suppressions>
  <suppress files="[\\/]target[\\/]" checks=".*"/>
  <suppress files="[\\/]generated-sources[\\/]" checks=".*"/>
  <suppress files="[\\/]generated-test-sources[\\/]" checks=".*"/>
</suppressions>
